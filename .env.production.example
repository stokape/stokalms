# ============================================================================
# .env.production.example — Plantilla de variables de PRODUCCION.
#
# Copiar a ".env.production" EN EL SERVIDOR (nunca en tu maquina, nunca al
# repo — ver .gitignore) y completar cada valor real. Alimenta a la vez:
#   - Las sustituciones ${VAR} de docker-compose.prod.yml y Caddyfile.
#   - Las variables de entorno de los contenedores "api" y "web"
#     (docker-compose.prod.yml los carga con "env_file: .env.production").
#
# Ver docs/deploy/produccion.md para la guia completa paso a paso (que
# dominio comprar, como generar cada secreto, orden de arranque, etc.).
# ============================================================================

# --- Dominio (ver docs/deploy/produccion.md, seccion DNS) -------------------
# Dominio raiz de LA PLATAFORMA (no de una institucion particular) — ej.
# "stokalms.com". Cada institucion nueva vive en un subdominio de este
# ("sanmartin.stokalms.com", ver tenant-domain.service.ts).
PLATFORM_ROOT_DOMAIN="tudominio.com"
# (WEB_ORIGIN, que scripts/setup-keycloak.js y keycloak-admin.service.ts
# necesitan, NO va aca — docker-compose.prod.yml ya lo arma solo como
# "https://${PLATFORM_ROOT_DOMAIN}", nada que configurar aparte).
# Subdominio dedicado a Keycloak (login/SSO) — DEBE tener su propio registro
# DNS tipo A apuntando a la IP del servidor, igual que el dominio raiz.
AUTH_DOMAIN="auth.tudominio.com"
# Email real: Let's Encrypt lo usa SOLO para avisar si un certificado esta
# por vencer y no se pudo renovar solo (raro, pero pasa) — no se comparte
# con nadie mas.
ACME_EMAIL="tu-email@tudominio.com"

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER="stoka"
POSTGRES_PASSWORD="reemplazar_con_una_contraseña_larga_al_azar"
POSTGRES_DB="stoka_lms"
# Contraseña del rol de base de datos RESTRINGIDO (sin permisos de
# superusuario, nombre FIJO "stoka_app") que usa la app para leer/escribir
# — ver ADR-001 y rls-policies.sql: Row-Level Security solo protege de
# verdad si la app NO se conecta como superusuario (que se salta cualquier
# política). El rol lo crea "apply-rls.js" (ver la guia de despliegue),
# leyendo esta misma variable — nunca queda con la contraseña de ejemplo
# publicada en rls-policies.sql.
RUNTIME_DB_PASSWORD="reemplazar_con_otra_contraseña_larga_al_azar"

# --- Keycloak ------------------------------------------------------------
# Cuenta de administracion de Keycloak (panel /admin) — SOLO para la
# primera vez que arranca el contenedor; cambiar despues desde el propio
# panel si se quiere.
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="reemplazar_con_una_contraseña_larga_al_azar"
KEYCLOAK_REALM="stoka-prod"
# Estos dos los genera Keycloak al crear los clientes "stoka-api"/"stoka-web"
# (ver "npm run keycloak:setup", que hay que volver a correr UNA VEZ contra
# este Keycloak de produccion — ver la guia de despliegue) — se completan
# recien despues de ese paso, no antes.
KEYCLOAK_CLIENT_SECRET="completar_despues_de_keycloak_setup"
AUTH_KEYCLOAK_ID="stoka-web"
AUTH_KEYCLOAK_SECRET="completar_despues_de_keycloak_setup"

# --- Archivos (Cloudflare R2 — gratis: 10GB y CERO costo de salida) ---------
# Por que R2 y no un MinIO propio en esta VM: un servicio menos que correr/
# respaldar/actualizar en el servidor, y R2 (a diferencia de S3) no cobra
# por trafico de salida — justo lo que mas se usa aca (certificados/PDFs/
# SCORM se descargan todo el tiempo). storage.service.ts habla el mismo SDK
# de S3 de siempre: R2 es compatible, no hace falta tocar nada de codigo.
#
# Como conseguir estos valores (dashboard de Cloudflare, mismo login que ya
# usas para el DNS de tu dominio):
#   1) R2 > Create bucket (nombre libre, ej. "stoka-lms-prod").
#   2) R2 > Manage API tokens > Create API token (permisos "Object Read &
#      Write", limitado a ese bucket) — te da el Access Key ID y el Secret
#      Access Key.
#   3) El "endpoint" de tu cuenta aparece en la misma pantalla de R2, con la
#      forma "https://<account-id>.r2.cloudflarestorage.com".
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="stoka-lms-prod"
STORAGE_ACCESS_KEY="completar_con_el_access_key_id_de_R2"
STORAGE_SECRET_KEY="completar_con_el_secret_access_key_de_R2"
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_MAX_UPLOAD_MB=100

# --- Backend (apps/api) ------------------------------------------------------
# URL PUBLICA de la API (queda incrustada, para siempre, en el codigo QR de
# cada certificado emitido — ver certificate.service.ts — asi que definila
# bien ANTES de emitir el primer certificado real).
API_PUBLIC_URL="https://api.tudominio.com/api/v1"
# Emails de quien puede aprobar instituciones nuevas (ver
# platform-admin.guard.ts) — separados por coma, sin espacios.
PLATFORM_ADMIN_EMAILS="tu-email@tudominio.com"
# Origenes permitidos para llamar a la API desde el NAVEGADOR — hoy
# apps/web nunca llama a la API desde el cliente (todo pasa por Server
# Actions/Server Components, ver lib/api.ts), asi que alcanza con el
# dominio raiz; si en el futuro se agrega algun fetch desde el navegador,
# hay que revisar tambien app.enableCors() en main.ts (una lista fija no
# puede cubrir subdominios dinamicos de instituciones).
CORS_ALLOWED_ORIGINS="https://tudominio.com"

# Secreto compartido SOLO entre el servidor de Next.js y esta API, para
# "POST /analytics/events" — DEBE coincidir EXACTO con ANALYTICS_INGEST_SECRET
# en apps/web (ver más abajo, sección de la app web). Generalo con:
#   openssl rand -hex 32
ANALYTICS_INGEST_SECRET="cambiame-openssl-rand-hex-32"

# --- Frontend (apps/web) -----------------------------------------------------
# Clave para firmar las cookies de sesion de NextAuth — generar UNA vez con
# "npx auth secret" o "openssl rand -base64 32"; NUNCA reusar la de
# desarrollo ni la de otro proyecto.
AUTH_SECRET="reemplazar_con_openssl_rand_-base64_32"
# NextAuth v5 rechaza el request por defecto si no corre en Vercel y no
# confia explicitamente en el host (protege contra ataques de "Host header"
# falso) — Caddy ya reenvia el Host real (ver Caddyfile), asi que es seguro
# confiar en el aca.
AUTH_TRUST_HOST="true"
