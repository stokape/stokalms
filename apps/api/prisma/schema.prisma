// ============================================================================
// schema.prisma — Fuente de verdad del modelo de datos de Stoka LMS.
//
// Este archivo es la "traduccion a codigo" del diagrama entidad-relacion
// documentado en docs/architecture/02-modelo-de-datos.md. Cada modelo de
// abajo corresponde exactamente a una entidad de ese diagrama; si cambias
// algo aqui, actualiza tambien el documento (y viceversa).
//
// Como funciona Prisma en este proyecto:
//   1) Este archivo describe las tablas (en lenguaje Prisma, no SQL directo).
//   2) "npx prisma migrate dev" LEE este archivo, genera SQL de migracion,
//      y lo aplica contra la base de datos definida en DATABASE_URL (.env).
//   3) "npx prisma generate" LEE este archivo y genera un cliente de
//      TypeScript (en apps/api/generated/, ver .gitignore) con autocompletado
//      exacto para cada modelo — eso es lo que usa PrismaService.
//
// IMPORTANTE — Row-Level Security (aislamiento multi-tenant, ver
// docs/architecture/adr/ADR-001-multi-tenancy.md): Prisma NO tiene sintaxis
// propia para declarar politicas RLS de PostgreSQL. Por eso, ademas de este
// archivo, existe "apps/api/prisma/rls-policies.sql", que se aplica DESPUES
// de cada migracion y activa el aislamiento a nivel de base de datos para
// cada tabla que tenga "tenantId".
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma lee la variable DATABASE_URL del ".env" (ver .env.example, raiz
  // del repo) — nunca se escribe la cadena de conexion real aqui.
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANT — cada entidad educativa (instituto, universidad, academia) que usa
// la plataforma. Es el "inquilino" del que habla la guia no tecnica
// (docs/guia-para-no-tecnicos.md, seccion 1: "un edificio con muchos inquilinos").
// ============================================================================
model Tenant {
  id             String   @id @default(uuid())
  name           String
  // Plan comercial contratado — uno de los 4 IDs de apps/web/lib/pricing.ts
  // ("starter" | "business" | "pro" | "enterprise", ver la validacion en
  // set-tenant-plan.dto.ts). Determina los feature flags por defecto en
  // TenantFeature.
  plan           String   @default("starter")
  // Configuracion de marca (logo, colores) en JSON: cambia con frecuencia y
  // es especifica de cada tenant, por eso no se modela como columnas fijas
  // (ver docs/architecture/02-modelo-de-datos.md, seccion 2.2). Forma
  // GUARDADA en esta columna (ver tenant.service.ts):
  //   { "logoKey"?: string, "backgroundImageKey"?: string, "backgroundColor"?: string }
  // "logoKey"/"backgroundImageKey" son keys DENTRO del bucket de archivos
  // (MinIO/S3, ver storage.service.ts) — el bucket NO es publico, asi que
  // tenant.service.ts (getCurrent/getPublicInfo) las resuelve a una URL
  // firmada FRESCA en cada respuesta (mismo patron que profile.service.ts
  // con el avatar), nunca se guarda una URL firmada directamente aca
  // (quedaria vencida a la hora). Se usa para personalizar el "home"
  // publico de CADA institucion (ver apps/web/app/page.tsx) — logo, nombre
  // y fondo propios antes de iniciar sesion.
  branding       Json     @default("{}")
  defaultLocale  String   @default("es") @map("default_locale")
  timezone       String   @default("America/Lima")
  createdAt      DateTime @default(now()) @map("created_at")

  // Modo mantenimiento: pantalla temporal que reemplaza el home publico (ver
  // apps/web/app/page.tsx) y bloquea el resto de la app (ver
  // apps/web/app/(app)/layout.tsx) para cualquiera que NO tenga el permiso
  // "tenant:edit" (Super Admin / Administrador de entidad, ver
  // tenant.controller.ts) — pensado para una mudanza de datos, un corte de
  // otro servicio, etc. "maintenanceEndsAt" es solo informativo (se muestra
  // como "volvemos aprox. a las...", pero NO desactiva el modo mantenimiento
  // automaticamente: alguien con permiso lo tiene que apagar a mano).
  maintenanceMode    Boolean   @default(false) @map("maintenance_mode")
  maintenanceMessage String?   @map("maintenance_message")
  maintenanceEndsAt  DateTime? @map("maintenance_ends_at")

  // Activacion/desactivacion a nivel de PLATAFORMA (ver
  // platform-tenants.service.ts) — distinto del modo mantenimiento de
  // arriba en dos formas clave: (1) lo prende/apaga un Administrador de
  // PLATAFORMA (PLATFORM_ADMIN_EMAILS), nunca la propia institucion; (2) NO
  // tiene excepcion para "tenant:edit" — ni siquiera el Super Admin de esa
  // institucion puede seguir usandola mientras esta desactivada. Pensado
  // para instituciones que dejaron de pagar, que pidieron pausar el
  // servicio, o que se dieron de baja pero cuyos datos todavia no se
  // borran. Se aplica en tenant-context.middleware.ts, ANTES de que el
  // request llegue a cualquier controlador.
  active Boolean @default(true)

  // --- Relaciones: todo lo que "pertenece" a este tenant ---
  domains             TenantDomain[]
  userMemberships     UserTenant[]
  roles               Role[]
  terms               Term[]
  gradingScales       GradingScale[]
  certificateTemplates CertificateTemplate[]
  certificates        Certificate[]
  features            TenantFeature[]
  auditLogs           AuditLog[]
  cohorts             Cohort[]
  reminderLogs        ReminderLog[]
  reportPresets       ReportPreset[]

  @@map("tenants")
}

// Dominio/subdominio propio de un tenant (ej. "academia" -> academia.stokalms.com,
// o un dominio custom "campus.institutosanmartin.edu.pe"). El middleware de
// resolucion de tenant (src/common/tenant) consulta esta tabla para saber a
// que tenantId corresponde el "Host" de cada request entrante.
model TenantDomain {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Dominio completo, ej. "academia.stokalms.com". Debe ser unico en TODA la
  // plataforma (dos tenants no pueden compartir el mismo dominio de entrada).
  domain   String @unique
  isPrimary Boolean @default(true) @map("is_primary")

  // Un dominio propio (ej. "campus.institutosanmartin.edu.pe", agregado por
  // un Administrador de plataforma via tenant-domain.service.ts) inicia SIN
  // verificar: hay que probar que quien lo pide de verdad controla ese
  // dominio antes de que tenant-context.middleware.ts empiece a resolverlo.
  // El default es "true" a proposito: el subdominio automatico que crea
  // tenant-registration.service.ts al aprobar una institucion (ej.
  // "sanmartin.stokalms.com") lo emite la plataforma misma, no hace falta
  // verificarlo — asi ninguna fila existente necesita backfill.
  verified          Boolean  @default(true) @map("is_verified")
  // Token aleatorio que quien pide agregar el dominio tiene que publicar
  // como registro TXT en "_stoka-verify.<dominio>" — ver
  // tenant-domain.service.ts#verify(). Se limpia (null) una vez verificado.
  verificationToken String?  @map("verification_token")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_domains")
}

// ============================================================================
// USUARIOS — USER es GLOBAL (una persona, una sola cuenta, sin importar en
// cuantos tenants participe). UserTenant es la MEMBRESIA de esa persona en
// un tenant especifico, y es la tabla que realmente lleva tenantId (ver
// docs/architecture/02-modelo-de-datos.md, seccion 2.2, primer punto).
// ============================================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Contraseña ya "hasheada" (nunca se guarda en texto plano). En el modulo
  // de autenticacion (proximo paso) esto convive con el login via Keycloak.
  passwordHash String?  @map("password_hash")
  fullName     String   @map("full_name")
  // "firstName"/"lastName" se completan SOLOS la primera vez que la persona
  // inicia sesion (ver auth.service.ts, findOrProvisionUser), a partir de
  // los claims "given_name"/"family_name" que ya trae el token de Keycloak
  // — son DISTINTOS de "fullName" (que sigue siendo el nombre "generico"
  // usado al matricular por email antes de que esa persona inicie sesion
  // ninguna vez) y existen para la pantalla de "Mi perfil", que necesita
  // mostrar nombre y apellido por separado.
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  // Datos de contacto/residencia — hoy SOLO se completan a mano en la base
  // de datos (no hay pantalla de edicion todavia: ver profile.controller.ts,
  // que a proposito solo permite actualizar la foto). Se guardan aqui, en
  // el User GLOBAL (no en UserTenant), porque son datos de la PERSONA, no
  // de su membresia en un tenant especifico.
  phone      String?
  address    String?
  department String? // Departamento (division administrativa peruana).
  province   String?
  district   String?
  // KEY dentro del almacenamiento de archivos (MinIO/S3, ver storage.service.ts),
  // NO una URL directa — mismo patron que Resource.storageUrl: el bucket es
  // privado, asi que "Mi perfil" pide una URL firmada de corta duracion
  // para mostrarla (ver profile.service.ts).
  avatarKey String? @map("avatar_key")
  createdAt DateTime @default(now()) @map("created_at")

  memberships UserTenant[]
  auditLogs   AuditLog[]

  @@map("users")
}

// Membresia de un User dentro de un Tenant especifico. Un mismo profesor
// puede tener una fila aqui por cada instituto en el que dicta clases.
model UserTenant {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "active" | "suspended" | "invited" — controla si esta persona puede
  // iniciar sesion dentro de ESTE tenant en particular.
  status   String @default("active")
  // "Fecha de inscripcion" que ve la propia persona en "Mi perfil" — es
  // CUANDO SE UNIO A ESTE TENANT especificamente (no la fecha global de
  // "createdAt" de User, que podria ser de otra institucion si esa persona
  // participa en mas de una, ver docs/architecture/02-modelo-de-datos.md).
  createdAt DateTime @default(now()) @map("created_at")

  // Cohorte a la que pertenece esta membresia (ej. "Promocion 2026", "Turno
  // manana") — ver Cohort mas abajo. Nulable: no toda persona tiene por
  // que estar en una cohorte (ej. personal administrativo). "SetNull" (no
  // "Cascade"): borrar una cohorte no debe borrar a sus miembros, solo
  // dejarlos sin cohorte asignada.
  cohortId String? @map("cohort_id")
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  roles       UserRole[]
  enrollments Enrollment[]
  authoredStudentNotes StudentNote[]
  uploadedEnrollmentAttachments EnrollmentAttachment[]
  remindersSent ReminderLog[]
  notifications Notification[]

  // Un mismo usuario no puede tener dos membresias distintas en el mismo tenant.
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([cohortId])
  @@map("user_tenants")
}

// ============================================================================
// COHORTES — agrupa alumnos (ej. "Promocion 2026", "Turno mañana") para
// matricular y reportar en bloque (ver cohort.service.ts). Vive a nivel de
// TENANT (no de curso): la misma cohorte de alumnos puede matricularse en
// varios cursos distintos a lo largo del tiempo, sin tener que recrearla
// cada vez.
// ============================================================================
model Cohort {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  members UserTenant[]

  @@index([tenantId])
  @@map("cohorts")
}

// ============================================================================
// RBAC — Roles y permisos (ver docs/architecture/03-rbac.md). Estas tablas
// son la FUENTE DE VERDAD que el motor Casbin (proximo paso) lee para armar
// sus politicas en memoria; Casbin nunca decide sin consultar estas tablas.
// ============================================================================
model Role {
  id           String  @id @default(uuid())
  // tenantId nulo = rol BASE del sistema (Admin, Docente, Estudiante...),
  // compartido por todos los tenants. Un rol con tenantId propio es un rol
  // personalizado creado por ese tenant especifico (ver 03-rbac.md, 3.3).
  tenantId     String? @map("tenant_id")
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  // Roles del sistema (isSystemRole = true) no pueden borrarse desde el panel
  // de administracion, aunque sus permisos si sean editables por tenant.
  isSystemRole Boolean @default(false) @map("is_system_role")

  permissions RolePermission[]
  assignments UserRole[]

  @@index([tenantId])
  @@map("roles")
}

// Catalogo GLOBAL de permisos posibles, expresados como "recurso:accion"
// (ej. resource="course", action="create"). No tiene tenantId: la lista de
// que PERMISOS EXISTEN es la misma para toda la plataforma; lo que cambia
// por tenant es que ROL tiene asignado cada permiso (tabla RolePermission).
model Permission {
  id       String @id @default(uuid())
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// Tabla "puente" muchos-a-muchos entre Role y Permission: cada fila dice
// "este rol incluye este permiso".
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Asignacion de un Rol a una Membresia (UserTenant) con un ALCANCE opcional:
// si scopeCourseId es null, el rol aplica a todo el tenant; si tiene un
// valor, el rol solo aplica dentro de ese curso especifico (ver 03-rbac.md,
// seccion 3.4 y el ejemplo del profesor que tambien es estudiante).
model UserRole {
  id             String      @id @default(uuid())
  // "tenantId" esta REPETIDO aqui a proposito (ya se puede deducir siguiendo
  // userTenant -> tenant), aunque tecnicamente es redundante. Se llama
  // "denormalizacion": la copiamos en cada tabla de negocio para que la
  // politica de Row-Level Security (ver prisma/rls-policies.sql y
  // docs/architecture/adr/ADR-001-multi-tenancy.md) pueda comparar
  // "tenant_id = current_setting(...)" DIRECTAMENTE, sin tener que hacer un
  // JOIN dentro de la politica (los JOINs dentro de politicas RLS se evaluan
  // en CADA fila de CADA consulta, y eso es lento a gran escala).
  tenantId       String      @map("tenant_id")
  userTenantId   String      @map("user_tenant_id")
  userTenant     UserTenant  @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  roleId         String      @map("role_id")
  role           Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeCourseId  String?     @map("scope_course_id")
  scopeCourse    Course?     @relation(fields: [scopeCourseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userTenantId])
  @@index([scopeCourseId])
  @@map("user_roles")
}

// ============================================================================
// ESTRUCTURA ACADEMICA — Term > Course > Section, y Course > Module > Lesson > Resource
// (ver docs/architecture/02-modelo-de-datos.md y docs/guia-para-no-tecnicos.md, seccion 2).
// ============================================================================

// Periodo academico propio de un tenant (ej. "2026 - Semestre I"). Cada
// tenant define el nombre/duracion que usa (semestre, ciclo, trimestre...).
model Term {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  courses Course[]

  @@index([tenantId])
  @@map("terms")
}

model Course {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  termId          String   @map("term_id")
  // onDelete: Restrict (no Cascade): borrar un periodo academico que
  // TODAVIA tiene cursos NO debe arrastrar silenciosamente todo lo que
  // cuelga de esos cursos (secciones, matriculas, notas, certificados...).
  // Postgres rechaza el DELETE del Term con un error explicito mientras
  // existan cursos asociados — el desafectado que se encuentre este error
  // primero debe borrar/mover los cursos a proposito. Se detecto esto
  // probando de verdad: un DELETE de prueba en el modulo Academico borro un
  // curso y su seccion en cascada sin avisar, con la config por defecto.
  term            Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  code            String
  title           String
  // Escala de notas que usa ESTE curso (cada tenant puede tener varias
  // escalas definidas y elegir cual aplica a cada curso).
  gradingScaleId  String?  @map("grading_scale_id")
  gradingScale    GradingScale? @relation(fields: [gradingScaleId], references: [id])
  // Plantilla de certificado FIJA de este curso — a diferencia del diseño
  // original (elegir la plantilla a mano en cada emision, ver
  // certificate.service.ts, "issue"), cada curso define UNA sola vez cual
  // usar, y la emision deja de pedirla. "onDelete: SetNull": borrar una
  // plantilla no debe impedir borrar/mantener el curso que la tenia asignada
  // — el curso simplemente queda sin plantilla hasta que se le asigne otra.
  certificateTemplateId String? @map("certificate_template_id")
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)

  sections           Section[]
  modules             Module[]
  assessments         Assessment[]
  gradebookCategories GradebookCategory[]
  roleAssignments     UserRole[]

  @@index([tenantId])
  @@index([termId])
  @@map("courses")
}

model Section {
  id       String @id @default(uuid())
  // Denormalizado para Row-Level Security directa (ver explicacion completa
  // en el modelo UserRole, mas arriba, y ADR-001-multi-tenancy.md).
  tenantId String @map("tenant_id")
  courseId String @map("course_id")
  // onDelete: Restrict — ver la nota extensa en Course.term, mismo
  // razonamiento: una seccion es donde hay estudiantes MATRICULADOS
  // (Enrollment); no debe poder desaparecer en cascada solo porque alguien
  // borro el curso.
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name     String
  // Horario de la seccion en JSON (dias, horas, aula) — flexible porque
  // cada institucion arma sus horarios de forma distinta.
  schedule Json   @default("{}")
  capacity Int    @default(0)

  enrollments Enrollment[]

  @@index([tenantId])
  @@index([courseId])
  @@map("sections")
}

model Module {
  id       String @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId String @map("tenant_id")
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  lessons     Lesson[]
  // Evaluaciones (examenes/tareas) que pertenecen a ESTE modulo en
  // particular — ver el comentario extenso en el modelo Assessment,
  // campo "moduleId": es OPCIONAL a proposito, para no romper evaluaciones
  // ya creadas antes de que este campo existiera.
  assessments Assessment[]
  // Modulos que este modulo exige tener completos antes de desbloquearse
  // (ver docs/guia-para-no-tecnicos.md, seccion 2, ejemplo de TechFuturo).
  requiredBy   ModulePrerequisite[] @relation("RequiredModule")
  prerequisites ModulePrerequisite[] @relation("DependentModule")

  @@index([tenantId])
  @@index([courseId])
  @@map("modules")
}

// Tabla puente que modela "el modulo B requiere haber completado el modulo A".
// Se modela como tabla aparte (en vez de una columna simple) porque un
// modulo podria, a futuro, depender de MAS de un prerequisito.
model ModulePrerequisite {
  id                 String @id @default(uuid())
  dependentModuleId  String @map("dependent_module_id")
  dependentModule    Module @relation("DependentModule", fields: [dependentModuleId], references: [id], onDelete: Cascade)
  requiredModuleId   String @map("required_module_id")
  requiredModule     Module @relation("RequiredModule", fields: [requiredModuleId], references: [id], onDelete: Cascade)

  @@unique([dependentModuleId, requiredModuleId])
  @@map("module_prerequisites")
}

model Lesson {
  id       String @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId String @map("tenant_id")
  moduleId String @map("module_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  content  String @default("")

  resources Resource[]
  views     LessonView[]

  @@index([tenantId])
  @@index([moduleId])
  @@map("lessons")
}

model Resource {
  id         String @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId   String @map("tenant_id")
  lessonId   String @map("lesson_id")
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // "video" | "pdf" | "scorm" | "link" | "image" | "presentation" | "spreadsheet"
  // | "document" | "doc" (comodín para cualquier otro tipo de archivo no
  // reconocido, ver resource.service.ts, "inferResourceType") — ver
  // docs/architecture/02-modelo-de-datos.md.
  type       String
  // URL dentro del almacenamiento de archivos (MinIO en local, S3/R2 en
  // produccion — ver .env.example, seccion STORAGE_*).
  storageUrl String @map("storage_url")
  metadata   Json   @default("{}")

  @@index([tenantId])
  @@index([lessonId])
  @@map("resources")
}

// ============================================================================
// MATRICULA — vincula un UserTenant (estudiante) con una Section especifica.
// ============================================================================
model Enrollment {
  id           String   @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId     String   @map("tenant_id")
  sectionId    String   @map("section_id")
  // onDelete: Restrict — una matricula es un registro academico (arrastra
  // entregas, notas, asistencia, certificados); no debe poder perderse en
  // cascada por borrar la seccion (ver la nota extensa en Course.term).
  section      Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  userTenantId String   @map("user_tenant_id")
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  // "active" | "dropped" | "completed" — "completed" es lo que puede disparar
  // la evaluacion de criterios de emision de certificado (ver flujo 4.3 en
  // docs/architecture/04-flujos-criticos.md).
  status       String   @default("active")
  enrolledAt   DateTime @default(now()) @map("enrolled_at")

  submissions        Submission[]
  attendanceRecords   AttendanceRecord[]
  certificates        Certificate[]
  studentNotes        StudentNote[]
  attachments         EnrollmentAttachment[]
  lessonViews         LessonView[]

  @@unique([sectionId, userTenantId])
  @@index([tenantId])
  @@index([sectionId])
  @@map("enrollments")
}

// ============================================================================
// EVALUACIONES Y CALIFICACIONES (ver docs/architecture/04-flujos-criticos.md,
// seccion 4.2, y docs/guia-para-no-tecnicos.md, seccion 4).
// ============================================================================

model GradebookCategory {
  id         String @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId   String @map("tenant_id")
  courseId   String @map("course_id")
  // onDelete: Restrict — protege la estructura de ponderacion de notas
  // (ver la nota extensa en Course.term).
  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name       String
  // Peso de esta categoria en la nota final del curso, en porcentaje (0-100).
  weightPct  Float  @map("weight_pct")
  // Cuantas notas de la categoria se descartan (la(s) mas baja(s)) al
  // calcular el promedio — ver ejemplo en docs/guia-para-no-tecnicos.md, 4.2.
  dropLowest Int    @default(0) @map("drop_lowest")

  assessments Assessment[]

  @@index([tenantId])
  @@index([courseId])
  @@map("gradebook_categories")
}

model Assessment {
  id                  String  @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId            String  @map("tenant_id")
  courseId            String  @map("course_id")
  // onDelete: Restrict — un curso con examenes/tareas ya creados (y
  // posiblemente ya calificados) no debe poder borrarse en cascada (ver la
  // nota extensa en Course.term).
  course              Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  gradebookCategoryId String  @map("gradebook_category_id")
  gradebookCategory   GradebookCategory @relation(fields: [gradebookCategoryId], references: [id])
  // A que Modulo pertenece esta evaluacion DENTRO del curso (ej. el examen
  // del Modulo 2) — OPCIONAL: onDelete SetNull (no Restrict) porque borrar
  // un modulo no deberia impedirse solo porque tiene una evaluacion ya
  // calificada colgando; simplemente esa evaluacion pasa a "sin modulo"
  // (sigue perteneciendo al curso). Nulo tambien cubre las evaluaciones
  // creadas ANTES de que este campo existiera.
  moduleId            String? @map("module_id")
  module              Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  // "exam" | "assignment" | "forum" | "rubric"
  type        String
  // Configuracion especifica del tipo (ej. auto_publish, ventana de tiempo,
  // politica de recuperacion) — flexible porque cada tipo tiene sus propias
  // opciones (ver docs/architecture/02-modelo-de-datos.md, ASSESSMENT.config).
  config      Json    @default("{}")
  maxPoints   Float   @map("max_points")
  maxAttempts Int     @default(1) @map("max_attempts")

  questions   Question[]
  submissions Submission[]

  @@index([tenantId])
  @@index([courseId])
  @@index([moduleId])
  @@map("assessments")
}

model Question {
  id            String @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId      String @map("tenant_id")
  assessmentId  String @map("assessment_id")
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // "mcq" (opcion multiple) | "open" (respuesta abierta) | "tf" (verdadero/falso) | "matching" (emparejamiento)
  type          String
  body          Json
  // Respuesta(s) correcta(s), usada para auto-calificar tipos "mcq"/"tf"/"matching".
  // En preguntas de tipo "open" queda vacia porque la califica un docente.
  correctAnswer Json   @default("{}") @map("correct_answer")
  points        Float

  answers SubmissionAnswer[]

  @@index([tenantId])
  @@index([assessmentId])
  @@map("questions")
}

model Submission {
  id            String   @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId      String   @map("tenant_id")
  assessmentId  String   @map("assessment_id")
  // onDelete: Restrict (ambas relaciones) — un Submission es evidencia
  // academica real (la entrega/intento de un estudiante, con su nota). Ni
  // borrar el Assessment ni borrar el Enrollment deben poder arrastrar en
  // cascada entregas ya calificadas (ver la nota extensa en Course.term).
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollmentId  String   @map("enrollment_id")
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  // Cada intento crea una fila NUEVA (nunca se sobreescribe una anterior),
  // para preservar el historial completo de intentos (ver 04-flujos-criticos.md, 4.2).
  attemptNumber Int      @default(1) @map("attempt_number")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  // "in_progress" | "submitted" | "pending_review" | "graded"
  status        String   @default("submitted")

  answers SubmissionAnswer[]
  grade   Grade?

  @@index([tenantId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@map("submissions")
}

model SubmissionAnswer {
  id           String     @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId     String     @map("tenant_id")
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String     @map("question_id")
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       Json
  // Puntaje obtenido en ESTA pregunta especifica (auto-calculado o puesto
  // manualmente por el docente segun el tipo de pregunta).
  score        Float?
  feedback     String?

  @@unique([submissionId, questionId])
  @@index([tenantId])
  @@map("submission_answers")
}

model Grade {
  id           String     @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId     String     @map("tenant_id")
  submissionId String     @unique @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rawScore     Float      @map("raw_score")
  // Nota final ya aplicando la escala del tenant (ver GradingScale) y el
  // redondeo configurado — ver ejemplo numerico completo en
  // docs/guia-para-no-tecnicos.md, seccion 4.4.
  finalScore   Float      @map("final_score")
  letterGrade  String?    @map("letter_grade")
  // Mientras "published" es false, el estudiante NO ve esta nota todavia
  // (el docente puede seguir corrigiendola antes de publicar el bloque).
  published    Boolean    @default(false)

  @@index([tenantId])
  @@map("grades")
}

// Escala de notas propia de un tenant (vigesimal/centesimal/literal). Ver
// docs/guia-para-no-tecnicos.md, seccion 4.2 (Instituto San Martin vs TechFuturo).
model GradingScale {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  // "vigesimal" (0-20) | "centesimal" (0-100) | "literal" (A/B/C/D/F, etc.)
  type            String
  // Bandas de conversion (ej. de rango numerico a letra), en JSON porque
  // cada tenant define sus propios cortes.
  bands           Json   @default("{}")
  decimalRounding Int    @default(0) @map("decimal_rounding")

  courses Course[]

  @@index([tenantId])
  @@map("grading_scales")
}

// ============================================================================
// ASISTENCIA
// ============================================================================
model AttendanceRecord {
  id           String   @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId     String   @map("tenant_id")
  enrollmentId String   @map("enrollment_id")
  // onDelete: Restrict — registro de asistencia real (ver la nota extensa
  // en Course.term).
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  sessionDate  DateTime @map("session_date")
  // "present" | "absent" | "late" | "excused"
  status       String
  // "manual" | "qr" — como se registro esta asistencia.
  method       String   @default("manual")

  // Una sola marca de asistencia por matricula y fecha de sesion — volver a
  // marcar el mismo dia es una CORRECCION (upsert), no una fila nueva (ver
  // attendance.service.ts, "mark").
  @@unique([enrollmentId, sessionDate])
  @@index([tenantId])
  @@index([enrollmentId])
  @@map("attendance_records")
}

// ============================================================================
// ANOTACIONES POR ALUMNO: observaciones de desempeño que un Docente deja
// sobre una matricula puntual (ej. "mejoro mucho su participacion", "no
// entrego la tarea 3") — a diferencia de una nota (Grade), no mide nada;
// es texto libre de seguimiento cualitativo. Cuelga de Enrollment con el
// mismo criterio que AttendanceRecord/Certificate (onDelete: Restrict — es
// un registro academico real, no debe perderse en cascada).
// ============================================================================
model StudentNote {
  id           String   @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId     String   @map("tenant_id")
  enrollmentId String   @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  // Quien la escribio (tipicamente el Docente del curso). onDelete: Restrict
  // porque es autoria de un registro academico — no debe desaparecer si
  // luego se le quita a esa persona su membresia en el tenant.
  authorId     String   @map("author_id")
  author       UserTenant @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([enrollmentId])
  @@map("student_notes")
}

// ============================================================================
// SUSTENTO DE UN CAMBIO DE ESTADO DE MATRICULA: cuando un Coordinador
// retira a un alumno, puede adjuntar un archivo de respaldo (ej. carta de
// retiro, certificado medico) como evidencia documental de por que se tomo
// esa decision. No se guarda "dentro" de Enrollment (un campo suelto)
// porque una misma matricula puede pasar por varios cambios de estado a lo
// largo del tiempo, cada uno con su propio sustento — es un historial, no
// un dato unico.
// ============================================================================
model EnrollmentAttachment {
  id           String   @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId     String   @map("tenant_id")
  enrollmentId String   @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  // Quien lo subio. onDelete: Restrict — mismo criterio que StudentNote.author.
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   UserTenant @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  // Key dentro del almacenamiento de archivos (MinIO/S3), no una URL publica
  // directa — mismo patron que Resource.storageUrl.
  storageKey   String   @map("storage_key")
  fileName     String   @map("file_name")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([enrollmentId])
  @@map("enrollment_attachments")
}

// ============================================================================
// SEGUIMIENTO DE AVANCE: registra la PRIMERA vez que un alumno abrio una
// Lesson puntual — es la señal minima necesaria para calcular "cuantas
// lecciones del curso ya vio" (ver academic-progress.service.ts en el
// backend). Deliberadamente NO registra cada apertura (eso seria un log de
// eventos, útil para analitica de uso pero no para lo que se necesita hoy:
// un simple "vista/no vista").
// ============================================================================
model LessonView {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  enrollmentId String   @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String   @map("lesson_id")
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime @default(now()) @map("first_viewed_at")

  // Una sola fila por matricula+leccion: la SEGUNDA vez que abre la misma
  // lección no crea un duplicado (ver academic-progress.service.ts,
  // "registrarVista", que hace upsert con "skipDuplicates").
  @@unique([enrollmentId, lessonId])
  @@index([tenantId])
  @@index([enrollmentId])
  @@map("lesson_views")
}

// ============================================================================
// CERTIFICADOS (ver docs/architecture/04-flujos-criticos.md, seccion 4.3, y
// docs/guia-para-no-tecnicos.md, seccion 5).
// ============================================================================
model CertificateTemplate {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  // Plantilla HTML editable por el propio tenant desde el panel (sin tocar
  // codigo); el worker de certificados la renderiza con Playwright headless
  // (ver docs/architecture/01-arquitectura-alto-nivel.md, tabla de stack).
  htmlTemplate  String   @map("html_template")
  // Lista de campos dinamicos que la plantilla puede usar (ej. nombre del
  // estudiante, curso, fecha, firma) — documentado para que el editor
  // visual del panel sepa que variables ofrecer.
  dynamicFields Json     @default("[]") @map("dynamic_fields")

  certificates Certificate[]
  courses      Course[]

  @@index([tenantId])
  @@map("certificate_templates")
}

model Certificate {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollmentId      String   @map("enrollment_id")
  // onDelete: Restrict — un certificado emitido es un documento con valor
  // legal/de verificacion publica (ver docs/architecture/04-flujos-criticos.md,
  // 4.3): NUNCA debe poder desaparecer por un borrado en cascada de otra
  // tabla. Se anula (campo "revoked"), nunca se borra.
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  templateId        String   @map("template_id")
  template          CertificateTemplate @relation(fields: [templateId], references: [id])
  // Codigo UNICO EN TODA LA PLATAFORMA (no solo dentro del tenant), porque
  // la URL publica de verificacion ("/verify/{codigo}") no lleva contexto
  // de tenant en la ruta (ver 02-modelo-de-datos.md, seccion 2.2).
  verificationCode  String   @unique @map("verification_code")
  pdfUrl            String   @map("pdf_url")
  issuedAt          DateTime @default(now()) @map("issued_at")
  revoked           Boolean  @default(false)

  @@index([tenantId])
  @@map("certificates")
}

// ============================================================================
// FEATURE FLAGS por tenant (ver docs/architecture/01-arquitectura-alto-nivel.md,
// seccion 1.5).
// ============================================================================
model TenantFeature {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureKey String  @map("feature_key")
  enabled    Boolean @default(false)
  config     Json    @default("{}")

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

// Registro de recordatorios automaticos YA enviados (ver
// automations.service.ts, "due_date_reminders") — su unico proposito es
// evitar mandar el MISMO recordatorio dos veces a la misma persona (el job
// diario corre todos los dias y volveria a encontrar la misma evaluacion
// "por vencer" si no quedara marcada como ya avisada).
model ReminderLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Hoy solo existe "assessment_due" (una evaluacion por vencer) — el campo
  // es texto libre (no un enum) para poder sumar otros tipos de recordatorio
  // mas adelante sin migracion.
  type         String
  // Id de la entidad que origino el recordatorio (hoy, un Assessment.id).
  referenceId  String   @map("reference_id")
  userTenantId String   @map("user_tenant_id")
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  sentAt       DateTime @default(now()) @map("sent_at")

  // Nunca el mismo recordatorio dos veces a la misma persona.
  @@unique([type, referenceId, userTenantId])
  @@index([tenantId])
  @@map("reminder_logs")
}

// "Reportes personalizados" (plan Pro, ver lib/pricing.ts): una seleccion
// de columnas GUARDADA con nombre, sobre uno de los 3 reportes que ya
// calcula reports.service.ts (nunca un reporte nuevo desde cero — ver
// REPORT_COLUMN_CATALOG en ese archivo) — asi un coordinador arma una
// vez "alumnos + nota final + sección" y lo vuelve a generar/exportar
// cada mes sin reconfigurar nada.
model ReportPreset {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  // "attendance" | "grades" | "enrollment_progress" — mismos 3 tipos que
  // ya existen, nunca una fuente de datos nueva.
  reportType String   @map("report_type")
  // Lista de keys de REPORT_COLUMN_CATALOG[reportType] (ej.
  // ["studentName","finalScore"]) — Json en vez de un String[] nativo de
  // Postgres, mismo criterio que Tenant.branding: todo campo de lista/
  // objeto libre de este proyecto vive en Json, para no mezclar dos
  // convenciones distintas de "arreglo" en el mismo schema.
  columns    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("report_presets")
}

// ============================================================================
// NOTIFICACIONES — avisos cortos dirigidos a UNA persona dentro de un tenant
// (ej. "se te asignó el rol Docente", "tu certificado de Contabilidad 101 ya
// está disponible"), que aparecen en la campana del panel (ver
// notification.service.ts). Deliberadamente simple para el MVP: solo in-app
// (nada de email/push todavía) y sin preferencias configurables por persona
// — cada disparador (ver notification.service.ts, metodo "notify") decide
// por sí mismo cuándo crear una.
// ============================================================================
model Notification {
  id       String @id @default(uuid())
  // Denormalizado para RLS directa (ver ADR-001-multi-tenancy.md).
  tenantId String @map("tenant_id")
  // A quién va dirigida — SIEMPRE una persona puntual, nunca "todo el
  // tenant" (un aviso institucional amplio ya se resuelve con el mensaje de
  // Mantenimiento, ver mantenimiento/page.tsx, no con esta tabla).
  userTenantId String     @map("user_tenant_id")
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  // Que evento la origino (ej. "role_assigned", "certificate_issued") — para
  // agrupar/filtrar sin tener que interpretar el texto libre.
  type  String
  title String
  body  String?
  // A donde lleva al hacer click (ej. "/matriculas/xxx/certificados") —
  // opcional: alguna notificacion puede ser solo informativa, sin destino.
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userTenantId, read])
  @@map("notifications")
}

// ============================================================================
// AUDITORIA — registra acciones sensibles (cambios de nota, certificados,
// permisos). Requerido por la Ley N 29733 / GDPR (ver
// docs/architecture/07-infraestructura.md, seccion 7.6).
// ============================================================================
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("audit_logs")
}

// ============================================================================
// SOLICITUD DE ALTA DE INSTITUCION — el formulario publico de "inscribi tu
// institucion" (ver apps/web/app/registro-institucion/) crea UNA de estas,
// NO un Tenant directo. Se decidio que el alta quede pendiente de revision
// manual (no autoservicio instantaneo): alguien de la plataforma (no de
// ningun tenant en particular) la aprueba o rechaza a mano.
//
// POR QUE NO TIENE "tenantId" Y NO USA Row-Level Security: al momento de
// crearse, todavia NO EXISTE ningun tenant al que pertenecer — es
// exactamente el mismo caso que "tenants" o "tenant_domains" (ver el
// principio de rls-policies.sql): esta tabla es "de la plataforma", no de
// un inquilino especifico.
//
// QUIEN LA PUEDE APROBAR/RECHAZAR: no un Administrador de entidad (ese rol
// es DENTRO de un tenant, y este tenant todavia no existe) — hace falta un
// concepto nuevo, "administrador de PLATAFORMA", que no encaja en el
// modelo de permisos por tenant (Casbin + dominios "tenant:<id>", ver
// casbin.service.ts). La simplificacion de este MVP (ver
// platform-admin.guard.ts) es una lista fija de emails autorizados
// (PLATFORM_ADMIN_EMAILS en .env), no un rol mas en la base de datos — si
// en el futuro hace falta administrar varias personas de plataforma con
// distintos niveles, ESE es el momento de modelar un dominio Casbin
// "platform" de verdad.
model TenantRegistrationRequest {
  id               String    @id @default(uuid())
  institutionName  String    @map("institution_name")
  // Subdominio deseado, ej. "instituto-sanmartin" (el dominio final
  // completo se arma en el momento de aprobar, concatenando
  // PLATFORM_ROOT_DOMAIN, ver tenant-registration.service.ts).
  desiredSubdomain String    @map("desired_subdomain")
  contactName      String    @map("contact_name")
  contactEmail     String    @map("contact_email")
  message          String?
  // "pending" | "approved" | "rejected".
  status           String    @default("pending")
  createdAt        DateTime  @default(now()) @map("created_at")
  reviewedAt       DateTime? @map("reviewed_at")
  rejectionReason  String?   @map("rejection_reason")
  // Se completa recien al aprobar (ver tenant-registration.service.ts,
  // metodo "approve"): el id del Tenant que se termino creando, para
  // poder rastrear de que solicitud salio cada institucion.
  createdTenantId  String?   @map("created_tenant_id")

  @@map("tenant_registration_requests")
}

// ============================================================================
// AnalyticsEvent — metricas del EMBUDO de incorporacion (onboarding), NO
// datos de negocio de ningun tenant (por eso no lleva "tenant_id" y no
// esta sujeta a Row Level Security, igual que TenantRegistrationRequest de
// arriba). Un solo evento generico con "metadata" libre (JSON) en vez de
// una tabla por tipo de evento: el embudo va a seguir cambiando (nuevos
// pasos, nuevos datos por paso) y esto evita una migracion cada vez.
//
// Grabado SIEMPRE desde el servidor (Server Components/Actions, nunca un
// script en el navegador) — ver apps/web/lib/analytics.ts: ni junta
// cookies de terceros ni IP/user-agent, lo minimo indispensable para
// contar el embudo (ver GET /analytics/funnel, admin-plataforma/metricas).
// ============================================================================
model AnalyticsEvent {
  id        String   @id @default(uuid())
  // Nombre del evento (ver AnalyticsEventName en analytics.ts, la lista
  // cerrada de valores validos vive en el FRONTEND, no aca — esta columna
  // es texto libre a proposito para no acoplar el schema del backend a
  // esa lista, que es la que mas cambia).
  event     String
  // Dominio desde el que se disparo (ej. "sanmartin.localhost",
  // "localhost") — permite distinguir el embudo de UNA institucion del
  // embudo de "acceso de administracion" (dominio raiz), sin exigir un
  // tenant ya resuelto (muchos eventos pasan ANTES de que exista tenant,
  // ej. "landing_view").
  host      String?
  // Datos propios de cada tipo de evento (ej. "found: true" en
  // "entrar_search") — sin columnas fijas por evento, ver la nota de
  // arriba.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  // El dashboard siempre filtra por evento y ordena/agrupa por fecha.
  @@index([event, createdAt])
  @@map("analytics_events")
}
