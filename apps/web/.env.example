# ============================================================================
# .env.example (apps/web) — Plantilla de variables de entorno del FRONTEND.
#
# Copiar a ".env.local" (el nombre que Next.js reconoce automaticamente para
# desarrollo local) y completar con valores reales. Ver tambien el
# ".env.example" de la raiz del repo, que documenta las variables del
# backend — este archivo es el equivalente para apps/web.
# ============================================================================

# --- NextAuth.js (autenticacion del frontend) ---
# Clave usada para firmar/cifrar las cookies de sesion de NextAuth. Generarla
# con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar_con_una_clave_aleatoria"

# Credenciales del cliente "stoka-web" en Keycloak (ver scripts/setup-keycloak.js,
# que las imprime en pantalla la primera vez que se corre "npm run keycloak:setup").
AUTH_KEYCLOAK_ID="stoka-web"
AUTH_KEYCLOAK_SECRET="reemplazar_con_el_secreto_generado_por_keycloak"
# Realm de Keycloak contra el que se autentica el frontend (debe coincidir
# con KEYCLOAK_REALM del backend).
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/stoka-dev"

# NextAuth v5 solo confia en el Host del request entrante (para construir
# su propia redirect_uri de OAuth) si corre en Vercel o si esto es
# "true" — sin esto, iniciar sesion desde CUALQUIER dominio que no sea
# exactamente el de "AUTH_KEYCLOAK_ISSUER" (ej. el subdominio de una
# institucion, o su dominio propio, ver /dominios) falla con
# "invalid_grant: Incorrect redirect_uri". Seguro de dejar en "true" aca:
# esta app YA valida el tenant por Host en el backend (ver
# tenant-context.middleware.ts) para todo lo que importa.
AUTH_TRUST_HOST="true"

# --- Backend (Core API) ---
# URL de la API que consume el frontend (ver apps/api/src/main.ts, prefijo
# global "/api/v1"). Sin NEXT_PUBLIC_, esta variable es SOLO visible en el
# servidor de Next.js (las paginas que llaman a la API corren como Server
# Components, ver app/dashboard/page.tsx) — nunca llega al navegador.
STOKA_API_URL="http://localhost:3001/api/v1"

# Dominio raiz de LA PLATAFORMA (no de una institucion) — admin-plataforma/
# layout.tsx lo usa para confirmar que /admin-plataforma solo se sirva
# desde ESE dominio, nunca desde el subdominio de una institucion. Sin
# declarar, cae a "localhost" (ver el fallback en el propio layout). En
# produccion, docker-compose.prod.yml se lo pasa solo via env_file
# (.env.production) -- no hace falta fijarlo a mano ahi.
PLATFORM_ROOT_DOMAIN="localhost"

# Secreto compartido con ANALYTICS_INGEST_SECRET del backend (ver
# .env.example de la raiz) — SOLO se usa server-side (lib/analytics.ts),
# nunca llega al navegador (sin prefijo NEXT_PUBLIC_). Debe coincidir EXACTO
# con el valor de la API.
ANALYTICS_INGEST_SECRET=""

# --- Cabeceras de seguridad (ver middleware.ts) ---
# Origen (protocolo + host + puerto, SIN ruta) del bucket de archivos
# (MinIO en local, S3/R2 en produccion — debe coincidir con STORAGE_ENDPOINT
# del backend, ver .env.example de la raiz). Se usa SOLO para armar la
# directiva "img-src" del Content-Security-Policy: logos y fondos de cada
# institucion se sirven desde ahi (URLs firmadas, ver tenant.service.ts),
# nunca desde el propio dominio de la app — sin esto en el CSP, el
# navegador bloquearia esas imagenes.
STORAGE_PUBLIC_ORIGIN="http://localhost:9000"
