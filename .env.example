# ============================================================================
# .env.example — PLANTILLA de variables de entorno de Stoka LMS.
#
# Este archivo SI se sube a Git (no tiene datos reales). Sirve como "receta"
# de que variables necesita el proyecto para funcionar.
#
# Para usarlo: copiar este archivo a ".env" (en la raiz) y reemplazar los
# valores de ejemplo por los reales. El archivo ".env" NUNCA se sube a Git
# (ver .gitignore) porque ahi si van contraseñas y claves reales.
#
# Relacion con el resto del proyecto:
# - docker-compose.yml lee estas variables para configurar Postgres,
#   Redis, MinIO y Keycloak en el entorno local.
# - apps/api/src/config/configuration.ts lee estas mismas variables dentro
#   del backend NestJS (a traves del modulo @nestjs/config).
# ============================================================================


# ----------------------------------------------------------------------------
# Base de datos (PostgreSQL) — ver docs/architecture/adr/ADR-004-base-datos.md
# ----------------------------------------------------------------------------
# Se usa "127.0.0.1" y NO "localhost" a proposito: en Windows, con Docker
# Desktop sobre WSL2, se detecto (probando de verdad, no en teoria) que
# Node/Prisma a veces resuelve "localhost" a la direccion IPv6 "::1", cuyo
# reenvio de puerto por WSL2 puede quedar en un estado roto sin que el
# resto del sistema lo note (un simple "Test-NetConnection localhost -Port
# 5432" de Windows daba OK igual). El sintoma fue un backend que fallaba al
# arrancar con "PrismaClientInitializationError: Can't reach database
# server at localhost:5432" a pesar de que Postgres estaba sano. Forzar la
# direccion IPv4 explicita evita por completo la ambiguedad de resolucion.
#
# DATABASE_URL: usuario ADMINISTRADOR (superusuario). Lo usan el CLI de
# Prisma ("prisma migrate", "prisma:rls") y NADA MAS. Necesita permisos
# amplios porque crea/modifica tablas.
DATABASE_URL="postgresql://stoka:stoka_dev_password@127.0.0.1:5432/stoka_lms?schema=public"

# RUNTIME_DATABASE_URL: usuario RESTRINGIDO ("stoka_app") que usa el backend
# NestJS mientras esta corriendo (ver src/prisma/prisma.service.ts). Es
# DELIBERADAMENTE distinto de DATABASE_URL: en PostgreSQL, un superusuario
# (como "stoka") se SALTA cualquier politica de Row-Level Security sin
# importar como este configurada — por eso el backend, en tiempo real, debe
# conectarse con un rol SIN privilegios de superusuario para que el
# aislamiento multi-tenant (ver ADR-001-multi-tenancy.md) realmente se
# aplique. Este rol lo crea "apply-rls.js" la primera vez que se corre
# "npm run prisma:rls" (ver apps/api/prisma/rls-policies.sql).
RUNTIME_DATABASE_URL="postgresql://stoka_app:stoka_app_dev_password@127.0.0.1:5432/stoka_lms?schema=public"


# ----------------------------------------------------------------------------
# Cache y colas (Redis) — ver docs/architecture/01-arquitectura-alto-nivel.md
# ----------------------------------------------------------------------------
# Redis se usa para: cachear permisos/feature-flags y como "broker" de las
# colas de trabajos en segundo plano (BullMQ): generar certificados,
# procesar matriculas masivas, enviar notificaciones.
REDIS_URL="redis://localhost:6379"


# ----------------------------------------------------------------------------
# Almacenamiento de archivos (S3 / MinIO) — ADR: almacenamiento de objetos
# ----------------------------------------------------------------------------
# En produccion esto apunta a Cloudflare R2 o AWS S3. En desarrollo local
# usamos MinIO (definido en docker-compose.yml), que imita la API de S3.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="stoka-lms-dev"
STORAGE_ACCESS_KEY="stoka_minio_admin"
STORAGE_SECRET_KEY="stoka_minio_dev_password"
# "true" cuando se usa MinIO local (necesita "path-style" en vez del estilo
# de subdominio que usa S3 real). En produccion contra S3/R2 se pone "false".
STORAGE_FORCE_PATH_STYLE="true"
# Tamaño maximo (en MB) de un archivo subido como recurso de leccion (video,
# PDF, paquete SCORM) — ver modules/content/resource.controller.ts. Sube a
# memoria antes de reenviar a MinIO/S3 (simplificacion del MVP), asi que
# este limite evita que un archivo enorme agote la memoria del proceso.
STORAGE_MAX_UPLOAD_MB=100


# ----------------------------------------------------------------------------
# Identidad y autenticacion (Keycloak) — ver ADR-003-auth-identity.md
# ----------------------------------------------------------------------------
# URL base del servidor Keycloak (definido en docker-compose.yml en local).
KEYCLOAK_BASE_URL="http://localhost:8080"
# "Realm" que usa la aplicacion para validar tokens durante el desarrollo.
# En produccion cada tenant puede tener su propio realm (ver ADR-003).
KEYCLOAK_REALM="stoka-dev"
# Credenciales del cliente OIDC que representa al backend NestJS ante Keycloak.
KEYCLOAK_CLIENT_ID="stoka-api"
KEYCLOAK_CLIENT_SECRET="reemplazar_con_el_secreto_generado_por_keycloak"


# ----------------------------------------------------------------------------
# Backend NestJS (apps/api) — ver apps/api/src/config/configuration.ts
# ----------------------------------------------------------------------------
# Puerto HTTP en el que escucha la API dentro del contenedor/maquina local.
API_PORT=3001
# Entorno de ejecucion: "development" | "test" | "production".
NODE_ENV="development"
# Dominio raiz de la plataforma, usado para resolver el tenant a partir del
# subdominio de cada request (ej. "academia" en "academia.stokalms.local").
# En DESARROLLO local, dejalo en "localhost" (asi funciona de una, ver la
# nota en scripts/setup-keycloak.js sobre WEB_ORIGIN) -- los navegadores
# resuelven cualquier "*.localhost" solos, sin tocar el archivo de hosts. En
# produccion, poné el dominio real de tu institucion/plataforma.
PLATFORM_ROOT_DOMAIN="localhost"

# Origen PUBLICO del frontend (ej. "https://stokalms.com" en produccion) —
# lo lee tanto scripts/setup-keycloak.js (con este mismo nombre) como el
# backend en tiempo real: al aprobar una institucion nueva, arma el
# redirect_uri de SU subdominio y se lo registra solo en el cliente
# "stoka-web" de Keycloak (ver keycloak-admin.service.ts). En desarrollo,
# dejalo en "http://localhost:3000".
WEB_ORIGIN="http://localhost:3000"

# URL publica y absoluta de ESTA MISMA API, tal como la alcanzaria alguien
# de afuera (no otro servicio de la red interna). La usa el backend para
# construir enlaces absolutos dentro de contenido generado — hoy, el unico
# caso es el codigo QR de un certificado (ver
# apps/api/src/modules/certificates/certificate.service.ts), que debe
# apuntar a "GET /verify/:codigo" de forma que funcione al escanearlo desde
# un papel impreso, no solo desde dentro de la red de desarrollo.
API_PUBLIC_URL="http://localhost:3001/api/v1"

# ----------------------------------------------------------------------------
# Correo saliente (SMTP) — ver apps/api/src/common/mail/mail.service.ts.
# Lo usa "automatizaciones" (recordatorios de fin de periodo, ver
# apps/api/src/modules/automations/) para enviar el email. VACIO por
# defecto a proposito: sin "SMTP_HOST" configurado, MailService directamente
# NO intenta enviar nada (deja un aviso en el log) — nunca se llena con
# datos de ejemplo, porque un valor "de mentira" aca daria la falsa
# impresion de que el correo si esta andando.
# ----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
# "true" si el proveedor exige TLS implicito desde el primer byte (tipico
# del puerto 465); con 587 (el mas comun) va en "false" (usa STARTTLS).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Stoka LMS <no-responder@stokalms.com>"

# ----------------------------------------------------------------------------
# IA generativa (plan Pro) — "Generar preguntas con IA" en una lección (ver
# apps/api/src/common/ai/). VACIO por defecto a proposito, mismo motivo que
# SMTP arriba: sin "AI_API_KEY", AiService NUNCA llama a ningun proveedor
# externo, solo avisa "no configurado" — la funcion queda construida, apagada.
# AI_BASE_URL/AI_MODEL asumen el formato de "chat completions" de OpenAI
# (varios proveedores lo replican) — cambiar de proveedor es, en general,
# solo cambiar estas dos variables.
# ----------------------------------------------------------------------------
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"


# Emails (separados por coma) con permiso de "administrador de PLATAFORMA":
# quien puede aprobar o rechazar solicitudes de alta de una institucion
# nueva (ver apps/api/src/auth/platform-admin.guard.ts). Es DISTINTO de
# "Administrador de entidad" (ese rol es DENTRO de un tenant ya existente).
# Vacio por defecto: nadie puede aprobar nada hasta que se configure.
PLATFORM_ADMIN_EMAILS=""

# Origenes (separados por coma) desde los que un NAVEGADOR puede llamar a
# esta API con JavaScript — ver src/main.ts, app.enableCors(). Hoy ningun
# codigo de navegador llama a esta API directo (el frontend siempre pasa
# por su propio servidor de Next.js, ver la nota en apps/web/lib/api.ts):
# esta variable es defensa en profundidad para si eso cambia algun dia.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Secreto compartido SOLO entre el servidor de Next.js y esta API, para
# "POST /analytics/events" (el unico endpoint de escritura sin sesion de
# usuario, ver analytics.controller.ts) — DEBE coincidir exactamente con
# ANALYTICS_INGEST_SECRET en apps/web/.env.local. Vacio = el endpoint queda
# sin este control (advertido en el codigo, no rompe nada) — genera un valor
# real con "openssl rand -hex 32" antes de produccion.
ANALYTICS_INGEST_SECRET=""


# ----------------------------------------------------------------------------
# Frontend Next.js (apps/web)
# ----------------------------------------------------------------------------
# A proposito NINGUNA variable de esta seccion lleva el prefijo
# "NEXT_PUBLIC_": ese prefijo la expondria tal cual al codigo que corre en
# el NAVEGADOR de cualquier visitante (visible en el HTML/JS servido, sin
# ninguna proteccion). Todo lo que el frontend necesita del backend pasa
# por su PROPIO servidor de Next.js (Server Components/Server Actions, ver
# apps/web/lib/api.ts) — ahi "STOKA_API_URL" (sin prefijo) alcanza y sobra,
# nunca hizo falta que el navegador supiera la URL de la API directamente.
# Si en el futuro una variable SI necesita ser publica, agregarle el
# prefijo recien ahi, nunca "por si acaso" — y nunca a un secreto/clave.
