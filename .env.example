# ============================================================================
# .env.example — PLANTILLA de variables de entorno de Stoka LMS.
#
# Este archivo SI se sube a Git (no tiene datos reales). Sirve como "receta"
# de que variables necesita el proyecto para funcionar.
#
# Para usarlo: copiar este archivo a ".env" (en la raiz) y reemplazar los
# valores de ejemplo por los reales. El archivo ".env" NUNCA se sube a Git
# (ver .gitignore) porque ahi si van contraseñas y claves reales.
#
# Relacion con el resto del proyecto:
# - docker-compose.yml lee estas variables para configurar Postgres,
#   Redis, MinIO y Keycloak en el entorno local.
# - apps/api/src/config/configuration.ts lee estas mismas variables dentro
#   del backend NestJS (a traves del modulo @nestjs/config).
# ============================================================================


# ----------------------------------------------------------------------------
# Base de datos (PostgreSQL) — ver docs/architecture/adr/ADR-004-base-datos.md
# ----------------------------------------------------------------------------
# DATABASE_URL: usuario ADMINISTRADOR (superusuario). Lo usan el CLI de
# Prisma ("prisma migrate", "prisma:rls") y NADA MAS. Necesita permisos
# amplios porque crea/modifica tablas.
DATABASE_URL="postgresql://stoka:stoka_dev_password@localhost:5432/stoka_lms?schema=public"

# RUNTIME_DATABASE_URL: usuario RESTRINGIDO ("stoka_app") que usa el backend
# NestJS mientras esta corriendo (ver src/prisma/prisma.service.ts). Es
# DELIBERADAMENTE distinto de DATABASE_URL: en PostgreSQL, un superusuario
# (como "stoka") se SALTA cualquier politica de Row-Level Security sin
# importar como este configurada — por eso el backend, en tiempo real, debe
# conectarse con un rol SIN privilegios de superusuario para que el
# aislamiento multi-tenant (ver ADR-001-multi-tenancy.md) realmente se
# aplique. Este rol lo crea "apply-rls.js" la primera vez que se corre
# "npm run prisma:rls" (ver apps/api/prisma/rls-policies.sql).
RUNTIME_DATABASE_URL="postgresql://stoka_app:stoka_app_dev_password@localhost:5432/stoka_lms?schema=public"


# ----------------------------------------------------------------------------
# Cache y colas (Redis) — ver docs/architecture/01-arquitectura-alto-nivel.md
# ----------------------------------------------------------------------------
# Redis se usa para: cachear permisos/feature-flags y como "broker" de las
# colas de trabajos en segundo plano (BullMQ): generar certificados,
# procesar matriculas masivas, enviar notificaciones.
REDIS_URL="redis://localhost:6379"


# ----------------------------------------------------------------------------
# Almacenamiento de archivos (S3 / MinIO) — ADR: almacenamiento de objetos
# ----------------------------------------------------------------------------
# En produccion esto apunta a Cloudflare R2 o AWS S3. En desarrollo local
# usamos MinIO (definido en docker-compose.yml), que imita la API de S3.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="stoka-lms-dev"
STORAGE_ACCESS_KEY="stoka_minio_admin"
STORAGE_SECRET_KEY="stoka_minio_dev_password"
# "true" cuando se usa MinIO local (necesita "path-style" en vez del estilo
# de subdominio que usa S3 real). En produccion contra S3/R2 se pone "false".
STORAGE_FORCE_PATH_STYLE="true"


# ----------------------------------------------------------------------------
# Identidad y autenticacion (Keycloak) — ver ADR-003-auth-identity.md
# ----------------------------------------------------------------------------
# URL base del servidor Keycloak (definido en docker-compose.yml en local).
KEYCLOAK_BASE_URL="http://localhost:8080"
# "Realm" que usa la aplicacion para validar tokens durante el desarrollo.
# En produccion cada tenant puede tener su propio realm (ver ADR-003).
KEYCLOAK_REALM="stoka-dev"
# Credenciales del cliente OIDC que representa al backend NestJS ante Keycloak.
KEYCLOAK_CLIENT_ID="stoka-api"
KEYCLOAK_CLIENT_SECRET="reemplazar_con_el_secreto_generado_por_keycloak"


# ----------------------------------------------------------------------------
# Backend NestJS (apps/api) — ver apps/api/src/config/configuration.ts
# ----------------------------------------------------------------------------
# Puerto HTTP en el que escucha la API dentro del contenedor/maquina local.
API_PORT=3001
# Entorno de ejecucion: "development" | "test" | "production".
NODE_ENV="development"
# Dominio raiz de la plataforma, usado para resolver el tenant a partir del
# subdominio de cada request (ej. "academia" en "academia.stokalms.local").
PLATFORM_ROOT_DOMAIN="stokalms.local"

# URL publica y absoluta de ESTA MISMA API, tal como la alcanzaria alguien
# de afuera (no otro servicio de la red interna). La usa el backend para
# construir enlaces absolutos dentro de contenido generado — hoy, el unico
# caso es el codigo QR de un certificado (ver
# apps/api/src/modules/certificates/certificate.service.ts), que debe
# apuntar a "GET /verify/:codigo" de forma que funcione al escanearlo desde
# un papel impreso, no solo desde dentro de la red de desarrollo.
API_PUBLIC_URL="http://localhost:3001/api/v1"


# ----------------------------------------------------------------------------
# Frontend Next.js (apps/web) — variable publica, visible en el navegador
# ----------------------------------------------------------------------------
# Prefijo NEXT_PUBLIC_ expone la variable al codigo del navegador; por eso
# aqui SOLO va la URL publica de la API, nunca contraseñas ni secretos.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
